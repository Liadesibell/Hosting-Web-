PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
TRUST_PROXY=

# Use the email address configured here to create the support administrator account.
ADMIN_EMAIL=admin@example.com
SUPPORT_EMAIL=support@example.com
MAIL_FROM=KokHost <no-reply@example.com>

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Incoming mailbox used to detect ONAYLANDI replies for IBAN approvals.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_MS=5000

# Bank transfer: verify every incoming transfer manually before marking it paid.
BANK_NAME=
BANK_ACCOUNT_NAME=
COMPANY_IBAN=

# The help assistant uses local prepared answers and does not need an external API key.